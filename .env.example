# Copy to .env and adjust as needed. All variables use the PDF2MD_ prefix.

# --- Infrastructure ---------------------------------------------------------
PDF2MD_DATABASE_URL=postgresql+asyncpg://pdf2md:pdf2md@db:5432/pdf2md
PDF2MD_REDIS_URL=redis://redis:6379/0
PDF2MD_CELERY_BROKER_URL=redis://redis:6379/0
PDF2MD_CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Storage (local Docker volumes) -----------------------------------------
PDF2MD_UPLOAD_DIR=/data/uploads
PDF2MD_OUTPUT_DIR=/data/outputs

# --- Limits -----------------------------------------------------------------
PDF2MD_MAX_UPLOAD_BYTES=52428800   # 50 MB
PDF2MD_MAX_PAGES=1000

# --- App --------------------------------------------------------------------
PDF2MD_LOG_LEVEL=INFO
PDF2MD_ENVIRONMENT=development
PDF2MD_CORS_ORIGINS=http://localhost:8080

# --- Diagram → Mermaid (Phase 3) -------------------------------------------
# hybrid: Ollama first, then configured OpenRouter → OpenAI → Anthropic.
# cloud: configured cloud keys only; local: Ollama only; openrouter: OpenRouter only.
PDF2MD_VLM_PROVIDER=hybrid
# Start optional local server + automatic model pull with:
# docker compose --profile local-vlm up --build
PDF2MD_OLLAMA_BASE_URL=http://ollama:11434
PDF2MD_OLLAMA_VISION_MODEL=llama3.2-vision
# OpenRouter: choose a model with image/vision input support.
PDF2MD_OPENROUTER_API_KEY=
PDF2MD_OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Optional app attribution headers (HTTP-Referer, X-OpenRouter-Title).
PDF2MD_OPENROUTER_SITE_URL=
PDF2MD_OPENROUTER_APP_NAME="PDF2MD Converter"
PDF2MD_OPENAI_API_KEY=
PDF2MD_OPENAI_VISION_MODEL=gpt-4o-mini
PDF2MD_ANTHROPIC_API_KEY=
PDF2MD_ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
PDF2MD_VLM_TIMEOUT_SECONDS=90
